{
  "name": "project-log",
  "version": "1.0.0",
  "private": true,
  "description": "Project schedule log with plan vs actual timeline. Cloudflare Worker + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply project-log --local",
    "db:migrate": "wrangler d1 migrations apply project-log --remote",
    "db:seed": "wrangler d1 execute project-log --remote --file=seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
